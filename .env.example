# Configuración de PymeBot. Copia esto a .env para desarrollo, o defínelo en tu hosting.

# ---- Obligatorio en producción ----

# La dirección pública. Sin esto, los links compartidos y el QR se deducen de cada
# petición, que detrás de algunos proxies apunta a localhost y deja el QR inservible.
PYMEBOT_PUBLIC_URL=https://chat.tupyme.cl

# Activa las cookies `secure` y las cabeceras de HTTPS. SIEMPRE en producción.
NODE_ENV=production

# ---- Con valores por defecto razonables ----

# Puerto. La mayoría de los hostings lo definen solos: no lo toques si es así.
PORT=3000

# Dónde se guardan negocios, cuentas y sesiones.
# EN PRODUCCIÓN TIENE QUE SER UN DISCO PERSISTENTE, o cada despliegue borra todo.
PYMEBOT_DATA_DIR=/data

# Cuántos proxies hay delante. Render, Fly y Railway ponen uno.
# Importa para el límite de peticiones: sin esto, todos los visitantes cuentan como uno.
PYMEBOT_TRUST_PROXY=1

# Negocio que atiende cuando se entra al chat sin indicar cuál.
PYMEBOT_BUSINESS=boracay-spa

# Cuenta del dueño. Con estas dos variables el servidor es el bot de ESE negocio: registro
# cerrado, sin negocios de ejemplo y la portada abre su chat. Al arrancar se crea la cuenta
# (si falta) con Boracay Spa (data/demo/boracay-spa.json). Cambiar la contraseña aquí y
# volver a desplegar es la forma de recuperarla.
# PYMEBOT_DUENO_EMAIL=dueno@tupyme.cl
# PYMEBOT_DUENO_PASSWORD=una-contraseña-larga

# Límites por IP. Solo súbelos si un negocio real se topa con ellos.
PYMEBOT_LIMIT_CHAT=30
PYMEBOT_LIMIT_AUTH=30
PYMEBOT_LIMIT_WRITE=120
